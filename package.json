{
  "name": "ultra-system-monitor",
  "productName": "Ultra System Monitor",
  "version": "1.0.0",
  "description": "Professional real-time system monitoring sidebar for Windows",
  "author": {
    "name": "AiCMS.BD",
    "email": "mail@aicms.bd"
  },
  "homepage": "https://aicms.bd",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "app": "electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
